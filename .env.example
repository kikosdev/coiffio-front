VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# Path A (multi-salon platform, default) vs Path B (mono-salon, annuaire masqué).
# Unset or any value other than "single" = platform mode.
# VITE_DEPLOYMENT_MODE=single

# Slug of the single salon shown in Path B mode (also the fallback for the legacy
# mono-salon /public/salons/:slug landing endpoints).
# VITE_DEFAULT_SALON_SLUG=salon-haire
